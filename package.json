{
  "name": "123dzo-smart-pos-kds",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3123",
    "build": "next build",
    "start": "next start -p 3123",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test:integration": "python -m unittest discover -s integration_test -p *_test.py -v",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration:kpi": "python integration_test/kpi_periods_test.py",
    "test:ux": "node integration_test/customer_ux_browser_test.mjs",
    "test:ux:manual": "node integration_test/manual_ux_browser_test.mjs",
    "test:ux:baseline": "node integration_test/baseline_browser_test.mjs",
    "test:staging:preflight": "node scripts/staging-preflight.mjs",
    "test:integration:preflight": "node --test integration_test/staging_preflight_test.mjs",
    "test:unit:watch": "vitest",
    "test:integration:staff": "python integration_test/staff_rpc_test.py",
    "test:integration:operations": "python integration_test/operation_rpc_test.py",
    "test:integration:orders": "python integration_test/dine_in_rpc_test.py",
    "test:integration:inventory": "python integration_test/inventory_rpc_test.py",
    "test:integration:returns": "python integration_test/beer_return_rpc_test.py",
    "test:integration:sessions": "python integration_test/session_rpc_test.py",
    "test:integration:transitions": "python integration_test/item_transition_rpc_test.py",
    "test:integration:menu": "python integration_test/menu_rpc_test.py",
    "test:integration:metadata": "python integration_test/metadata_rpc_test.py",
    "test:integration:images": "python integration_test/menu_images_rpc_test.py",
    "test:integration:seed": "python integration_test/demo_seed_test.py",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration:reads": "python integration_test/read_boundaries_test.py",
    "test:integration:notifications": "python integration_test/notification_worker_test.py",
    "test:integration:pwa": "node integration_test/pwa_browser_test.mjs",
    "test:integration:realtime": "python integration_test/realtime_policy_test.py",
    "assets:pwa": "node scripts/generate-pwa-assets.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.0",
    "@serwist/next": "^9.0.12",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "serwist": "^9.0.12",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.0.2",
    "web-push": "^3.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
