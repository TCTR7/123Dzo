# ============================================================================
# 1. SUPABASE (Database, Realtime & Storage - Region: ap-southeast-1)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================================
# 2. CLERK AUTHENTICATION & RBAC (Roles: admin | staff | kitchen)
# ============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ============================================================================
# 3. WEB PUSH NOTIFICATION (VAPID KEYS)
# ============================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@123dzo.vn

# ============================================================================
# 4. VIETQR & CỔNG THANH TOÁN TỰ ĐỘNG (PayOS / SePay)
# ============================================================================
NEXT_PUBLIC_VIETQR_BANK_ID=MB
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=0987654321
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=QUAN NHAU 123DZO
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret
