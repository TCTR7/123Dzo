# ============================================================================
# 1. SUPABASE (Database, Realtime & Storage - Region: ap-southeast-1)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Enable only after imported ES256 key + private-channel staging acceptance.
NEXT_PUBLIC_PRIVATE_REALTIME_ENABLED=false
# Server-only EC P-256 private JWK with kid; never paste into NEXT_PUBLIC settings.
REALTIME_SIGNING_JWK=
# Verified customer information; no sample address/phone/bank is shipped.
NEXT_PUBLIC_STORE_NAME=
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_STORE_PHONE=
NEXT_PUBLIC_STORE_HOURS=
NEXT_PUBLIC_STORE_INFO_VERIFIED=false
NEXT_PUBLIC_MANUAL_TAKEAWAY_ENABLED=false
NEXT_PUBLIC_BANK_INFO_VERIFIED=false
# Required before enabling public takeaway creates; server-only, never NEXT_PUBLIC.
# Choose vercel (requires real Vercel runtime) or proxy (trusted ingress only).
TAKEAWAY_REQUEST_SOURCE=
TAKEAWAY_RATE_LIMIT_SECRET=
TAKEAWAY_PROXY_SECRET=
TAKEAWAY_RATE_NETWORK_MINUTE=10
TAKEAWAY_RATE_NETWORK_HOUR=120
TAKEAWAY_RATE_GLOBAL_MINUTE=60
TAKEAWAY_RATE_GLOBAL_HOUR=600

# ============================================================================
# 2. CLERK AUTHENTICATION & RBAC (Roles: admin | staff | kitchen)
# ============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ============================================================================
# 3. WEB PUSH NOTIFICATION (VAPID KEYS)
# ============================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=

# ============================================================================
# 4. MANUAL VIETQR — verified Techcombank BIN: 970407, no bank API required
# ============================================================================
NEXT_PUBLIC_VIETQR_BANK_ID=
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=
# Legacy automatic webhook stays disabled in manual-payment v1.
PAYOS_CHECKSUM_KEY=
SEPAY_WEBHOOK_SECRET=

# Cron: generate a random secret of at least 32 characters; never expose publicly.
CRON_SECRET=
NOTIFICATION_WORKER_SECRET=
# Manual checkout requires verified store + account and explicit enable above.
